{
  "appId": "com.stonic.ai",
  "productName": "STONIC AI",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "dist-react/**/*",
    "electron/python/**/*",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "sign": null
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "STONIC AI",
    "differentialPackage": false
  }
}
